# mini-harness 环境配置模板
#
# 用法：
#   cp .env.example .env   # 填入自己的值（至少 VIBE_API_KEY）
#   set -a; source .env; set +a
#
# 注意：.env 已被 .gitignore 忽略，不要提交；本文件只放占位值，不写真实 key。
# 程序不会自动读取 .env，需要 source 或手动 export。

# ---- 模型 API（OpenAI-compatible） ----
# 必填：三者任选其一，VIBE_API_KEY 优先；其余两个是兼容别名。
VIBE_API_KEY=sk-your-key-here
#OPENAI_API_KEY=
#DEEPSEEK_API_KEY=
# 服务地址与模型名；默认是 DeepSeek 的 OpenAI 兼容接口。
VIBE_BASE_URL=https://api.deepseek.com/v1
VIBE_MODEL=deepseek-chat
# provider：openai | fake；fake 不需要 key，只验证界面与协议接线。
#VIBE_PROVIDER=openai
# 1 时 fake provider 跑确定性演示（写 .vibe/fake-demo.txt → 审批 → 验证 → 回执）。
#VIBE_FAKE_DEMO=0

# ---- 授权档位与审批策略 ----
# ask：逐次审批；edits：自动放行工作区文件修改；
# workspace：再放行工作区命令；full：再放行网络与 MCP（浏览器动作仍逐次）。
#VIBE_AUTONOMY=ask
# 用户审批策略文件路径；留空字符串表示禁用（评测 / 基准建议禁用）。
#VIBE_PERMISSIONS=

# ---- 验收与审计 ----
# 完成守卫 / 只读环境审计默认开启；设为 0 可关闭。
#VIBE_COMPLETION_GUARD=1
#VIBE_WORKSPACE_AUDIT=1
# 1 开启可选 LLM 只读审计（额外一次模型调用，默认 0）。
#VIBE_LLM_AUDITOR=0
# LLM 审计要求契约反查 aligned（默认 1）；0 时允许 unknown。
#VIBE_CONTRACT_BACKCHECK=1

# ---- 执行隔离（可选，macOS Seatbelt） ----
# 1 开启沙箱：写入限工作区与临时目录，默认断网。
#VIBE_SANDBOX=0
# 1 允许沙箱内网络（优先于域名白名单）。
#VIBE_SANDBOX_NETWORK=0
# 只允许这些域名，逗号分隔，支持 *.example.com。
#VIBE_SANDBOX_NETWORK_ALLOW=

# ---- 运行预算与上下文（可选） ----
# 1M 上下文窗口；0 表示单任务步数不限。
#VIBE_CONTEXT_WINDOW=1000000
#VIBE_MAX_STEPS=0
#VIBE_MAX_RUN_SECONDS=1800
# 远程 API 需要走代理时设为 1（默认不读代理环境变量）。
#VIBE_TRUST_ENV=0

# ---- MCP 外部工具（可选） ----
# 配置文件路径与内联服务定义，格式见 docs/USAGE.md。
#VIBE_MCP_CONFIG=
#VIBE_MCP_SERVERS=
