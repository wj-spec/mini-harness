# mini-harness 环境配置模板
#
# 用法：
#   cp .env.example .env   # 填入自己的值（至少 VIBE_API_KEY）
#   set -a; source .env; set +a
#
# 注意：.env 已被 .gitignore 忽略，不要提交；本文件只放占位值，不写真实 key。
# 程序不会自动读取 .env，需要 source 或手动 export。

# ---- 模型 API（OpenAI-compatible） ----
# 必填：三者任选其一，VIBE_API_KEY 优先；其余两个是兼容别名。
VIBE_API_KEY=sk-your-key-here
#OPENAI_API_KEY=
#DEEPSEEK_API_KEY=
# 服务地址与模型名；默认是 DeepSeek 的 OpenAI 兼容接口。
VIBE_BASE_URL=https://api.deepseek.com/v1
VIBE_MODEL=deepseek-chat
# provider：openai | fake；fake 不需要 key，只验证界面与协议接线。
#VIBE_PROVIDER=openai
# 1 时 fake provider 跑确定性演示（写 .vibe/fake-demo.txt → 审批 → 验证 → 回执）。
#VIBE_FAKE_DEMO=0
# fake provider 故障注入：在脚本前插入 N 次可重试流错误（0-5），用于评测/回归。
#VIBE_FAKE_STREAM_ERRORS=0

# ---- 授权档位与审批策略 ----
# ask：逐次审批；edits：自动放行工作区文件修改；
# workspace：再放行工作区命令；full：再放行网络与 MCP（浏览器动作仍逐次）。
#VIBE_AUTONOMY=ask
# 用户审批策略文件路径；留空字符串表示禁用（评测 / 基准建议禁用）。
#VIBE_PERMISSIONS=

# ---- 验收与审计 ----
# 完成守卫 / 只读环境审计默认开启；设为 0 可关闭。
#VIBE_COMPLETION_GUARD=1
#VIBE_WORKSPACE_AUDIT=1
# 1 开启可选 LLM 只读审计（额外一次模型调用，默认 0）。
#VIBE_LLM_AUDITOR=0
# LLM 审计要求契约反查 aligned（默认 1）；0 时允许 unknown。
#VIBE_CONTRACT_BACKCHECK=1

# ---- 执行隔离（可选，macOS Seatbelt） ----
# 1 开启沙箱：写入限工作区与临时目录，默认断网。
#VIBE_SANDBOX=0
# 1 允许沙箱内网络（优先于域名白名单）。
#VIBE_SANDBOX_NETWORK=0
# 只允许这些域名，逗号分隔，支持 *.example.com。
#VIBE_SANDBOX_NETWORK_ALLOW=

# ---- 运行预算与上下文（可选） ----
# 1M 上下文窗口；0 表示单任务步数不限。
#VIBE_CONTEXT_WINDOW=1000000
#VIBE_MAX_STEPS=0
#VIBE_MAX_RUN_SECONDS=1800
# 单次模型请求的输出 token 上限；0=不额外限制（服务端默认）
#VIBE_LLM_MAX_OUTPUT_TOKENS=0
# LLM 调试日志（请求/响应/首字节/结束耗时）；默认关闭
#VIBE_LLM_DEBUG_PATH=.vibe/llm-debug.jsonl
# 远程 API 需要走代理时设为 1（默认不读代理环境变量）。
#VIBE_TRUST_ENV=0

# ---- MCP 外部工具（可选） ----
# 配置文件路径与内联服务定义，格式见 docs/USAGE.md。
#VIBE_MCP_CONFIG=
#VIBE_MCP_SERVERS=

# 计划验收命令（Plan acceptance）
# 验收失败后自动让模型修复并重验的次数；0=关闭，最大 3
#VIBE_ACCEPTANCE_REPAIR_ATTEMPTS=0
#VIBE_ACCEPTANCE_RETRIES=0
#VIBE_ACCEPTANCE_TIMEOUT_SECONDS=300
#VIBE_ACCEPTANCE_TOTAL_TIMEOUT_SECONDS=0

# ---- 无人值守 profile 审批门（可选） ----
# 1 时，放宽了默认策略的 .vibe/unattended.json 必须先经 --approve-unattended-profile 批准
# （记录 profile hash；profile 再改需重新批准），否则 worker 拒绝启动。
#VIBE_UNATTENDED_REQUIRE_APPROVAL=0

# ---- 外部告警 webhook（可选） ----
# 通知同时 POST JSON 到 webhook；只允许 http/https，失败静默不影响主流程。
#VIBE_NOTIFY_WEBHOOK=https://example.com/hook
# 只推送指定 kind（逗号分隔，* 表示全部）；留空=全部。
#VIBE_NOTIFY_WEBHOOK_KINDS=approval_requested,approval_timeout,goal_stopped,merge_completed
#VIBE_NOTIFY_WEBHOOK_TIMEOUT_SECONDS=3

# ---- 会话日志软上限 ----
# events.jsonl 是会话恢复权威来源，不自动轮转；超过软上限时后台 worker 写
# session_events_large 通知与任务事件（0=关闭告警）。
#VIBE_EVENTS_MAX_BYTES=33554432

# ---- 长任务资源上限（0=不限） ----
# goal 模式：最多段数、总时长（秒）、总 token、总费用（USD）。
# 前台 TUI 与后台 worker goal 循环都按这些上限停止（后台按 budget.jsonl 累计）。
#VIBE_GOAL_MAX_SEGMENTS=8
#VIBE_GOAL_SECONDS=14400
#VIBE_GOAL_MAX_TOKENS=0
#VIBE_GOAL_MAX_COST_USD=0

# ---- P2 只读子 Agent 委派（opt-in，可选） ----
# 1 时主 Agent 获得只读 delegate 工具（不嵌套、只读子集、受父预算上限约束；结果标 untrusted）。
#VIBE_SUBAGENT_DELEGATE=0
#VIBE_DELEGATE_MAX_STEPS=6
#VIBE_DELEGATE_MAX_TOKENS=20000
#VIBE_DELEGATE_MAX_SECONDS=60

# ---- /explore 子 Agent 预算（可选） ----
#VIBE_EXPLORE_MAX_STEPS=6
#VIBE_EXPLORE_MAX_TOKENS=20000
#VIBE_EXPLORE_MAX_SECONDS=60

# ---- 评测版本标识（可选） ----
# bench_long.py / real_p1_acceptance.py 报告里的 agent_version；默认 git short HEAD。
#VIBE_BENCH_AGENT_VERSION=

# ---- 评测/测试用确定性时钟（可选） ----
# 只影响 goal 续段判定里的"当前时间"，用于模拟长时段；不要用于真实运行。
#VIBE_FAKE_TIME_OFFSET_SECONDS=0
