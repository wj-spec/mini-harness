{
  "mcpServers": {
    "browser": {
      "command": "npx",
      "args": [
        "--offline", "--package", "@playwright/mcp@0.0.83",
        "-c", ".venv/bin/python3 -m app.browser_server"
      ],
      "env": {
        "NPM_CONFIG_CACHE": ".vibe/npm-cache",
        "PLAYWRIGHT_BROWSERS_PATH": ".vibe/ms-playwright",
        "HOME": ".vibe/browser/home",
        "XDG_CACHE_HOME": ".vibe/browser/cache",
        "TMPDIR": ".vibe/browser/tmp",
        "PWTEST_SOCKETS_DIR": "/tmp/vibe-browser-sockets"
      },
      "cwd": ".",
      "timeout": 90,
      "risk": "read",
      "browser_actions": true,
      "allowed_tools": [
        "browser_navigate", "browser_snapshot", "browser_console_messages",
        "browser_network_requests", "browser_close", "browser_click",
        "browser_type", "browser_select_option"
      ],
      "allowed_origins": ["http://localhost:3000", "http://127.0.0.1:3000"]
    }
  }
}
