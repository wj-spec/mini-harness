{
  "id": "real-restart-attach",
  "modes": ["real"],
  "description": "真实 provider 下 attach 观察运行中 worker，detach 后任务继续完成",
  "objective": "读取 README.md，用一句话说明项目用途后结束。只读，不要修改任何文件。",
  "action": "attach",
  "worker_env": {
    "VIBE_MAX_STEPS": "4",
    "VIBE_MAX_RUN_TOKENS": "60000"
  },
  "expected": {
    "task_status": ["completed"],
    "worker_status": ["exited"],
    "min_segments": 1,
    "no_changed_files": true
  },
  "timeout_seconds": 180
}
